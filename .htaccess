# Para hospedagens Apache ou LiteSpeed (Hostinger, Locaweb, KingHost, HostGator, cPanel em geral).
# Vercel, Netlify e Cloudflare Pages ignoram este arquivo e já fazem tudo isso sozinhos.
# Se a hospedagem mostrar "Erro 500" depois de publicar, apague este arquivo: o site funciona sem ele.

# Página própria para endereços que não existem
ErrorDocument 404 /404.html

# Tipos de arquivo que alguns servidores antigos não conhecem
<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType font/woff2 .woff2
  AddType video/mp4 .mp4
</IfModule>

# Compressão (deixa as páginas bem mais leves)
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/javascript application/javascript application/json image/svg+xml text/plain
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml text/plain
</IfModule>

# Cache: páginas sempre atualizadas; scripts por 1 semana; imagens, vídeos e fonte por 1 mês
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/javascript "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType video/mp4 "access plus 30 days"
  ExpiresByType font/woff2 "access plus 30 days"
</IfModule>
